# Lovely Tech POS — production server configuration
# Copy this file to backend/.env on the cashier/server laptop and replace every secret/password value.
APP_ENV=production
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql+psycopg://lovely_pos:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/lovely_tech_pos
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
SESSION_TIMEOUT_ADMIN_MINUTES=5
SESSION_TIMEOUT_CASHIER_MINUTES=60
SESSION_ABSOLUTE_TIMEOUT_ADMIN_HOURS=12
SESSION_ABSOLUTE_TIMEOUT_CASHIER_HOURS=12
CRITICAL_REAUTH_REQUIRED=true
CORS_ORIGINS=tauri://localhost,http://tauri.localhost
BACKUP_ROOT=C:/ProgramData/LovelyTechPOS/backups
PG_DUMP_BIN=pg_dump
PG_RESTORE_BIN=pg_restore
PSQL_BIN=psql
GOOGLE_DRIVE_RCLONE_REMOTE=
GOOGLE_DRIVE_BACKUP_PATH=Lovely-Tech-POS
RCLONE_BIN=rclone
REQUIRE_VERIFIED_BACKUP_FOR_CLOSE=true
# Shift End / Day End start an automatic backup and complete only after it is verified.
BACKUP_CLOSE_MAX_ATTEMPTS=10
BACKUP_CLOSE_REUSE_SECONDS=60
BACKUP_UPLOAD_ATTEMPTS=3
# Separate USB/external/network folder used when Google Drive is unreachable (leave empty to disable).
BACKUP_ALTERNATE_TARGET=
BACKUP_SYNC_RETRY_INTERVAL_SECONDS=300
APP_VERSION=0.4.0
PROTOCOL_VERSION=1.0.0
API_VERSION=1
BRANCH_CODE=MAIN
INSTANCE_ID_FILE=C:/ProgramData/LovelyTechPOS/server-data/instance.json
