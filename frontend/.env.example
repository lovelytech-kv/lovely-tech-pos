# Local development overrides. Copy to .env and edit for local Vite dev only.
#
# In production Tauri builds, the client discovers the POS server automatically
# via mDNS + /discovery/info identity verification. No server address is baked
# into the packaged client. The build script (scripts/windows/Build-LovelyTechClient.ps1)
# accepts -ServerUrl only to verify reachability during build; the resulting exe
# does not embed that address.
#
# VITE_API_BASE is an optional development/manual override:
#   - Leave as /api/v1 for normal Vite dev (proxied to the backend).
#   - Set an absolute URL (http://host:8000/api/v1) to point dev at a remote server.
#   - Production builds do NOT read this file; it is ignored at runtime.
VITE_API_BASE=/api/v1
VITE_API_TIMEOUT_MS=15000