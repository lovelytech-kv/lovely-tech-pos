"""Tests for migration 0037: add commit metadata to import_batches."""
import os
import uuid
from datetime import datetime, timezone

import pytest
from sqlalchemy import create_engine, text
from sqlalchemy.orm import Session
from sqlalchemy.pool import NullPool

# Skip if no PostgreSQL test DB configured
TEST_DATABASE_URL = os.environ.get("TEST_DATABASE_URL")
if not TEST_DATABASE_URL:
    pytest.skip(
        "TEST_DATABASE_URL not set; skipping PostgreSQL migration tests",
        allow_module_level=True,
    )

os.environ["DATABASE_URL"] = TEST_DATABASE_URL

from alembic import command
from alembic.config import Config

alembic_cfg = Config("C:/Lovely Tech POS/backend/alembic.ini")
alembic_cfg.set_main_option("sqlalchemy.url", TEST_DATABASE_URL)


def _create_engine():
    return create_engine(TEST_DATABASE_URL, poolclass=NullPool)


def _reset_db(engine):
    with engine.begin() as conn:
        conn.execute(text("DROP SCHEMA public CASCADE"))
        conn.execute(text("CREATE SCHEMA public"))


class TestMigration0037:
    def setup_method(self):
        self.engine = _create_engine()
        _reset_db(self.engine)
        command.upgrade(alembic_cfg, "0036_import_batch_idempotency")

    def teardown_method(self):
        self.engine.dispose()

    def test_upgrade_adds_commit_metadata_columns(self):
        command.upgrade(alembic_cfg, "0037")
        with self.engine.begin() as conn:
            res = conn.execute(text("""
                SELECT column_name, is_nullable, data_type
                FROM information_schema.columns
                WHERE table_name = 'import_batches'
                ORDER BY ordinal_position
            """))
            cols = {r[0]: {"nullable": r[1] == "YES", "type": r[2]} for r in res}
        assert "committed_at" in cols
        assert cols["committed_at"]["nullable"] is True
        assert "committed_by" in cols
        assert cols["committed_by"]["nullable"] is True
        assert "commit_result" in cols
        assert cols["commit_result"]["nullable"] is True
        assert "failure_reason" in cols
        assert cols["failure_reason"]["nullable"] is True

    def test_downgrade_removes_commit_metadata_columns(self):
        command.upgrade(alembic_cfg, "0037")
        command.downgrade(alembic_cfg, "0036_import_batch_idempotency")
        with self.engine.begin() as conn:
            res = conn.execute(text("""
                SELECT column_name
                FROM information_schema.columns
                WHERE table_name = 'import_batches'
            """))
            cols = {r[0] for r in res}
        assert "committed_at" not in cols
        assert "committed_by" not in cols
        assert "commit_result" not in cols
        assert "failure_reason" not in cols

    def test_existing_batches_remain_intact_after_upgrade(self):
        # Create minimal schema state data
        with self.engine.begin() as conn:
            # branches, users, roles
            bid = str(uuid.uuid4())
            uid = str(uuid.uuid4())
            rid = str(uuid.uuid4())
            branch_id = str(uuid.uuid4())
            conn.execute(text(f"INSERT INTO branches (id, code, name, is_active, created_at, updated_at) VALUES ('{branch_id}', 'B1', 'Branch 1', true, NOW(), NOW())"))
            conn.execute(text(f"INSERT INTO roles (id, code, name, is_system, created_at, updated_at) VALUES ('{rid}', 'ADMIN', 'Admin', true, NOW(), NOW())"))
            conn.execute(text(f"INSERT INTO users (id, username, password_hash, display_name, role_id, branch_id, is_active, must_change_password, failed_login_count, discount_limit_percent, created_at, updated_at, version) VALUES ('{uid}', 'admin', 'hash', 'Admin', '{rid}', '{branch_id}', true, false, 0, 0, NOW(), NOW(), 1)"))
            batch_id = str(uuid.uuid4())
            content_hash = "a" * 64
            conn.execute(text(f"""
                INSERT INTO import_batches (id, branch_id, filename, uploaded_by, uploaded_at, status, import_type, content_hash, created_at, updated_at)
                VALUES ('{batch_id}', '{branch_id}', 'test.csv', '{uid}', NOW(), 'PENDING_APPROVAL', 'ITEM', '{content_hash}', NOW(), NOW())
            """))
            conn.execute(text(f"""
                INSERT INTO import_staging_rows (id, batch_id, row_number, row_type, raw_data, validation_status, created_at, updated_at)
                VALUES (gen_random_uuid(), '{batch_id}', 2, 'ITEM', '{{"ITEM CODE": "X1", "DESCRIPTION": "Test"}}'::jsonb, 'VALID', NOW(), NOW())
            """))
        command.upgrade(alembic_cfg, "0037")
        with self.engine.begin() as conn:
            res = conn.execute(text(f"SELECT status, import_type, committed_at, committed_by, commit_result, failure_reason FROM import_batches WHERE id='{batch_id}'"))
            row = res.fetchone()
        assert row[0] == "PENDING_APPROVAL"
        assert row[1] == "ITEM"
        assert row[2] is None
        assert row[3] is None
        assert row[4] is None
        assert row[5] is None
